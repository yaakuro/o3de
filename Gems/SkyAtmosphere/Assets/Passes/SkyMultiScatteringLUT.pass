{
    "Type": "JsonSerialization",
    "Description": "This is the pass template that renders the sky multiple scattering approximation LUT",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "SkyMultiScatteringLUTTemplate",
            "PassClass": "ComputePass",
            "Slots": [
                {
                    "Name": "SkyTransmittanceLUTInput",
                    "SlotType": "Input",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_transmittanceLUT"
                },
                {
                    "Name": "SkyMultiScatteringLUTOutput",
                    "SlotType": "Output",
                    "ScopeAttachmentUsage": "Shader",
                    "ShaderInputName": "m_multiScatteringLUTOutput"
                }
            ],
            "PassData": {
                "$type": "ComputePassData",
                "ThreadCountX": "32",
                "ThreadCountY": "32",
                "ThreadCountZ": "64",
                "ShaderAsset": {
                    "FilePath": "Shaders/SkyAtmosphere/SkyMultiScatteringLUT.shader"
                },
                "BindViewSrg": true
            }
        }
    }
}
